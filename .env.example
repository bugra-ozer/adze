# Postgres (used by docker-compose.yml and DATABASE_URL below)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=adze-db
DATABASE_URL=postgresql://admin:admin@localhost:5432/adze-db

# GitHub webhook secret (set when you configure the webhook in GitHub's settings)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# STRIPE_WEBHOOK_SECRET=
# TWILIO_AUTH_TOKEN=